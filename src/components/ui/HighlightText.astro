---
interface Props {
  text: string;
  highlight: string[];
}
const { text, highlight } = Astro.props;
const escaped = highlight.map((word) =>
  word.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"),
);
const parts = escaped.length
  ? text.split(new RegExp(`(${escaped.join("|")})`, "gi"))
  : [text];
---

<span class="text-sm">
  {parts.map((part, index) =>
    index % 2 ? (
      <mark class="bg-primary/20 font-bold text-base-content not-italic">
        {part}
      </mark>
    ) : (
      part
    ),
  )}
</span>
