---
import { blogCount } from "../../data/blog";
import { getMessages, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { blogTitle, blogPostLabel } = getMessages(locale).Publications;
---

<section class="mx-auto max-w-5xl px-4 pt-8" id="tech-blog">
  <div class="my-6 flex justify-center">
    <h2 class="text-3xl font-bold">
      {blogTitle}
    </h2>
  </div>
  <div
    class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
  >
    {Array.from({ length: blogCount }, (_, index) => (
      <a
        href={`https://alvinvin.hatenablog.jp/entry/${index + 1}`}
        aria-label={`${blogPostLabel} ${index + 1}`}
        target="_blank"
        rel="noreferrer"
        class="card aspect-square overflow-hidden shadow transition-transform hover:scale-[1.01]"
      >
        <figure class="h-full">
          <img
            width="300"
            height="300"
            src={`/images/blog/${index + 1}.webp`}
            alt=""
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </figure>
      </a>
    ))}
  </div>
</section>
