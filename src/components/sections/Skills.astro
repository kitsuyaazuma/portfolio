---
import { getMessages, type Locale } from "../../i18n";
import SkillsChart from "../ui/SkillsChart.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 py-8" id="skills">
  <div class="my-6 flex justify-center">
    <h2 class="text-3xl font-bold">{getMessages(locale).Skills.title}</h2>
  </div>
  <SkillsChart locale={locale} />
</section>
