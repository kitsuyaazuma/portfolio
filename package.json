{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/update-article-metadata.ts && node prebuild.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "imagemin": "bash image2webp.sh",
    "update:ogp": "tsx scripts/update-blog-ogp.ts && biome format --write messages",
    "update:article-metadata": "tsx scripts/update-article-metadata.ts",
    "astro": "astro",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/partytown": "^2.1.8",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/simple-icons": "^1.2.99",
    "@iconify-json/tabler": "^1.2.42",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "astro-icon": "^1.2.0",
    "daisyui": "^5.7.47",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "open-graph-scraper": "^6.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
